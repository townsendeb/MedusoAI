# Public site URLs (marketing vs app)
NEXT_PUBLIC_MARKETING_URL=https://medusoai.com
NEXT_PUBLIC_APP_URL=https://app.medusoai.com

# Supabase (from project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Inngest (local dev: run `npm run dev:inngest` alongside `npm run dev`)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Telephony (default: agentphone). Set to "legacy" for Twilio SMS + Retell voice.
TELEPHONY_PROVIDER=agentphone

# AgentPhone (primary SMS + voice) — leave unset to run in stub mode
# AGENTPHONE_API_KEY=sk_live_...
# AGENTPHONE_AGENT_ID=agt_...
# AGENTPHONE_NUMBER_ID=num_...
# AGENTPHONE_WEBHOOK_SECRET=whsec_...

# OpenAI — leave unset to use canned SMS replies in stub mode
# OPENAI_API_KEY=

# Local dev overrides (optional)
# OUTREACH_DELAY_MINUTES=1
# CONVERSATION_TIMEOUT_MINUTES=2

# Sentry — leave unset to disable error monitoring
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# Secondary telephony (TELEPHONY_PROVIDER=legacy only)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# RETELL_API_KEY=
# RETELL_AGENT_ID=

# Stripe — leave unset to disable checkout; usage limits still apply
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
